<?xml version="1.0" encoding="utf-8"?>
<!-- Deny cleartext; system CAs only. PipeLeap is offline — no app network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
